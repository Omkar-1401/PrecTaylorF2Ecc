wheel: setup.py
	prefix="$(abs_builddir)/build/inst"; \
	$(MAKE) \
		prefix="$${prefix}" \
		pkgdatadir="$${prefix}/share" \
		PYTHON_PREFIX="$${prefix}" \
		PYTHON_EXEC_PREFIX="$${prefix}" \
		LALSUITE_PYTHON_SYS_PREFIX="$${prefix}" \
		-C .. install-strip \
	&& \
	$(PYTHON) setup.py bdist_wheel -d .

